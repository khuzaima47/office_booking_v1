<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <.header>
    <%= @room.name %>
    <:subtitle><%= @room.location %> • Up to <%= @room.capacity %> people</:subtitle>
    <:actions>
      <.link patch={~p"/rooms/#{@room}/show/edit"} phx-click={JS.push_focus()}>
        <.button>Edit room</.button>
      </.link>
      <.link navigate={~p"/rooms"}>
        <.button class="bg-gray-500 hover:bg-gray-600">Back to Rooms</.button>
      </.link>
    </:actions>
  </.header>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
    <!-- Room Photos -->
    <div>
      <h2 class="text-xl font-semibold mb-4">Photos</h2>
      
      <%= if @room.photos != [] do %>
        <!-- Primary Photo -->
        <%= if primary_photo = OfficeBooking.Rooms.Room.primary_photo(@room) do %>
          <div class="mb-4 relative">
            <img 
              src={OfficeBooking.Rooms.RoomPhoto.web_path(primary_photo)}
              alt={@room.name}
              class="w-full h-64 object-cover rounded-lg shadow-md"
            />
            <span class="absolute top-4 left-4 bg-green-600 text-white text-sm px-3 py-1 rounded">
              Primary Photo
            </span>
          </div>
        <% end %>
        
        <!-- Secondary Photos -->
        <% secondary_photos = OfficeBooking.Rooms.Room.secondary_photos(@room) %>
        <%= if secondary_photos != [] do %>
          <div>
            <h3 class="text-lg font-medium mb-3">Additional Photos</h3>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              <div :for={photo <- secondary_photos} class="relative group">
                <img 
                  src={OfficeBooking.Rooms.RoomPhoto.web_path(photo)}
                  alt={@room.name}
                  class="w-full h-24 object-cover rounded cursor-pointer hover:opacity-90"
                />
                
                <!-- Photo Actions -->
                <div class="absolute inset-0 bg-black bg-opacity-50 opacity-0 group-hover:opacity-100 transition-opacity rounded flex items-center justify-center space-x-2">
                  <button
                    phx-click="set_primary_photo"
                    phx-value-photo-id={photo.id}
                    class="px-2 py-1 bg-blue-600 text-white text-xs rounded hover:bg-blue-700"
                  >
                    Set Primary
                  </button>
                  <button
                    phx-click="delete_photo"
                    phx-value-photo-id={photo.id}
                    data-confirm="Delete this photo?"
                    class="px-2 py-1 bg-red-600 text-white text-xs rounded hover:bg-red-700"
                  >
                    Delete
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-12 bg-gray-50 rounded-lg">
          <.icon name="hero-photo" class="h-16 w-16 text-gray-400 mx-auto mb-4" />
          <p class="text-gray-500">No photos uploaded yet</p>
          <.link patch={~p"/rooms/#{@room}/show/edit"} class="text-blue-600 hover:text-blue-800">
            Add photos
          </.link>
        </div>
      <% end %>
    </div>

    <!-- Room Details -->
    <div>
      <div class="bg-white border border-gray-200 rounded-lg p-6">
        <h2 class="text-xl font-semibold mb-4">Room Details</h2>
        
        <dl class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd class="mt-1">
              <span class={[
                "inline-flex px-2 py-1 text-sm rounded-full",
                if(@room.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800")
              ]}>
                <%= if @room.is_active, do: "Active", else: "Inactive" %>
              </span>
            </dd>
          </div>
          
          <%= if @room.description do %>
            <div>
              <dt class="text-sm font-medium text-gray-500">Description</dt>
              <dd class="mt-1 text-sm text-gray-900"><%= @room.description %></dd>
            </div>
          <% end %>
          
          <div>
            <dt class="text-sm font-medium text-gray-500">Capacity</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @room.capacity %> people</dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500">Location</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @room.location %></dd>
          </div>
          
          <div>
            <dt class="text-sm font-medium text-gray-500">Created</dt>
            <dd class="mt-1 text-sm text-gray-900">
              <%= Calendar.strftime(@room.inserted_at, "%B %d, %Y at %I:%M %p") %>
            </dd>
          </div>
        </dl>
      </div>

      <!-- Features -->
      <div class="bg-white border border-gray-200 rounded-lg p-6 mt-6">
        <h2 class="text-xl font-semibold mb-4">Features & Amenities</h2>
        
        <%= if @room.features != [] do %>
          <div class="space-y-3">
            <div 
              :for={feature <- @room.features}
              class="flex items-start p-3 bg-blue-50 rounded-lg"
            >
              <.icon name="hero-check-circle" class="h-5 w-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" />
              <div>
                <div class="font-medium text-blue-900"><%= feature.feature_name %></div>
                <%= if feature.description && feature.description != "" do %>
                  <div class="text-sm text-blue-700 mt-1"><%= feature.description %></div>
                <% end %>
              </div>
            </div>
          </div>
        <% else %>
          <div class="text-center py-8 text-gray-500">
            <.icon name="hero-list-bullet" class="h-12 w-12 text-gray-400 mx-auto mb-3" />
            <p>No features added yet</p>
            <.link patch={~p"/rooms/#{@room}/show/edit"} class="text-blue-600 hover:text-blue-800">
              Add features
            </.link>
          </div>
        <% end %>
      </div>
    </div>
  </div>


<.back navigate={~p"/rooms"}>Back to rooms</.back>

<.modal :if={@live_action == :edit} id="room-modal" show on_cancel={JS.patch(~p"/rooms/#{@room}")}>
    <.live_component
      module={OfficeBookingWeb.RoomLive.FormComponent}
      id={@room.id}
      title={@page_title}
      action={@live_action}
      room={@room}
      patch={~p"/rooms/#{@room}"}
    />
  </.modal>
</div>