<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <.header>
    Room Management
    <:subtitle>Manage office rooms, features, and photos</:subtitle>
    <:actions>
      <.link patch={~p"/rooms/new"}>
        <.button>New Room</.button>
      </.link>
    </:actions>
  </.header>

  <.table
    id="rooms"
    rows={@streams.rooms}
    row_click={fn {_id, room} -> JS.navigate(~p"/rooms/#{room}") end}
  >
    <:col :let={{_id, room}} label="Name">
      <div class="flex items-center">
        <%= if primary_photo = OfficeBooking.Rooms.Room.primary_photo(room) do %>
          <img 
            src={OfficeBooking.Rooms.RoomPhoto.web_path(primary_photo)}
            alt={room.name}
            class="w-12 h-12 object-cover rounded mr-3"
          />
        <% else %>
          <div class="w-12 h-12 bg-gray-200 rounded mr-3 flex items-center justify-center">
            <.icon name="hero-photo" class="h-6 w-6 text-gray-400" />
          </div>
        <% end %>
        <div>
          <div class="font-medium"><%= room.name %></div>
          <div class="text-sm text-gray-500"><%= room.location %></div>
        </div>
      </div>
    </:col>
    
    <:col :let={{_id, room}} label="Capacity">
      <%= room.capacity %> people
    </:col>
    
    <:col :let={{_id, room}} label="Features">
      <div class="flex flex-wrap gap-1">
        <span 
          :for={feature <- Enum.take(OfficeBooking.Rooms.Room.feature_names(room), 2)}
          class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded"
        >
          <%= feature %>
        </span>
        <%= if length(OfficeBooking.Rooms.Room.feature_names(room)) > 2 do %>
          <span class="inline-block bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded">
            +<%= length(OfficeBooking.Rooms.Room.feature_names(room)) - 2 %>
          </span>
        <% end %>
      </div>
    </:col>
    
    <:col :let={{_id, room}} label="Status">
      <span class={[
        "inline-flex px-2 py-1 text-xs rounded-full",
        if(room.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800")
      ]}>
        <%= if room.is_active, do: "Active", else: "Inactive" %>
      </span>
    </:col>
    
    <:col :let={{_id, room}} label="Photos">
      <%= length(room.photos) %> photos
    </:col>

    <:action :let={{_id, room}}>
      <div class="flex gap-2">
        <.link patch={~p"/rooms/#{room}/edit"}>Edit</.link>
        <.link 
          phx-click={JS.push("toggle_active", value: %{id: room.id})}
          data-confirm={if room.is_active, do: "Deactivate this room?", else: "Activate this room?"}
        >
          <%= if room.is_active, do: "Deactivate", else: "Activate" %>
        </.link>
      </div>
    </:action>
    
    <:action :let={{id, room}}>
      <.link
        phx-click={JS.push("delete", value: %{id: room.id}) |> hide("##{id}")}
        data-confirm="Are you sure?"
      >
        Delete
      </.link>
    </:action>
  </.table>

  <.modal :if={@live_action in [:new, :edit]} id="room-modal" show on_cancel={JS.patch(~p"/rooms")}>
    <.live_component
      module={OfficeBookingWeb.RoomLive.FormComponent}
      id={@room.id || :new}
      title={@page_title}
      action={@live_action}
      room={@room}
      patch={~p"/rooms"}
    />
  </.modal>
</div>